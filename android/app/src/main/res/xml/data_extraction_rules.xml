<?xml version="1.0" encoding="utf-8"?>
<!-- Ключи не попадают ни в облачную резервную копию, ни при переносе на новый телефон:
     они зашифрованы ключом, который живёт только в этом телефоне, и на другом всё равно не открылись бы. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
