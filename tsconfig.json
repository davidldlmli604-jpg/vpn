{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["./core/*"],
      "@shared/*": ["./shared/*"],
      "@brand": ["./brand.json"]
    }
  },
  "include": ["src", "shared", "core", "brand.json", "vite.config.ts"]
}
